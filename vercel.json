{
    "version": 2,
    "builds": [
        {
            "src": "vercel_entry/index.php",
            "use": "vercel-php@0.8.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*\\.(png|jpg|jpeg|gif|ico|svg|css|js|xml))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/vercel_entry/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:pAhfelYxV13VpygZ4yCuTtF5jM1vpuNmUT5DyJHE0Eg=",
        "APP_URL": "https://tengganglopi-two.vercel.app",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "120",
        "SESSION_COOKIE": "tengganglopi_session",
        "BCRYPT_ROUNDS": "12",
        "APP_MAINTENANCE_DRIVER": "file",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp"
    }
}
